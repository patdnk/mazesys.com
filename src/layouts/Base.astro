---
// Shared page shell. `section` switches the header between the Maze Sys site and an app's pages.
import '../styles/global.css';
import { contactEmail } from '../data/apps';

interface Props {
  title: string;
  description: string;
  section?: 'mazesys' | 'zerobite';
  /** Hide the top bar and footer (the home page leads with the logo and has its own contact line). */
  bare?: boolean;
  /** Social preview image (1200 × 630), as a path under public/. */
  image?: string;
  imageAlt?: string;
  /** schema.org structured data, written into the head as JSON-LD. */
  jsonLd?: object;
}

const { title, description, section = 'mazesys', bare = false, image, imageAlt, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteName = section === 'zerobite' ? 'Zero Bite' : 'Maze Sys';
const imageUrl = image && new URL(image, Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
      </>
    )}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" href={section === 'zerobite' ? '/zerobite/mark.svg' : '/favicon.svg'} />
    {section !== 'zerobite' && <link rel="apple-touch-icon" href="/apple-touch-icon.png" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Mona+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class:list={[{ plain: bare }]}>
    <div class="wrap">
      {!bare && <header class="site">
        {section === 'zerobite' ? (
          <>
            <a href="/zerobite/"><img src="/zerobite/mark.svg" alt="" />Zero Bite</a>
            <nav>
              <a href="/zerobite/support.html">Support</a>
              <a href="/zerobite/privacy-policy.html">Privacy</a>
            </nav>
          </>
        ) : (
          <>
            <a href="/" class="wordmark">maze sys</a>
            <nav><a href={`mailto:${contactEmail}`}>Contact</a></nav>
          </>
        )}
      </header>}

      <main>
        <slot />
      </main>

      {!bare && <footer>
        {section === 'zerobite' ? (
          <>
            <p>
              <a href="/zerobite/support.html">Support</a> · <a href="/zerobite/privacy-policy.html">Privacy policy</a> ·
              <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
            </p>
            <p>
              Recall information from the Food Standards Agency, licensed under the Open Government Licence v3.0. Zero Bite
              isn’t affiliated with the FSA.
            </p>
            <p><a href="/">A Maze Sys app</a></p>
          </>
        ) : (
          <p>Maze Sys · <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
        )}
      </footer>}
    </div>
  </body>
</html>

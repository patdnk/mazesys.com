---
import Base from '../layouts/Base.astro';
import StudioDiagram from '../components/StudioDiagram.astro';
import Steroids from '../components/Steroids.astro';
import { apps, contactEmail } from '../data/apps';
// Traced from design/mazesys-logo-source.jpg by scripts/trace-logo.py; inlined so CSS can animate each wall.
import logo from '../assets/mazesys-logo.svg?raw';

const skills = [
  'iOS', 'Swift', 'SwiftUI', 'Android', 'Kotlin', 'KMP', 'Expo', 'React Native',
  'TypeScript', 'Node.js', 'Microsoft Fabric', 'Power BI',
];

const services = [
  {
    title: 'iOS and Android apps',
    body: 'Native Swift and SwiftUI on iPhone, Kotlin and Jetpack Compose on Android, or one shared codebase with Kotlin Multiplatform or React Native when that suits the budget better. Designed, built and taken through store review.',
  },
  {
    title: 'Backends and web',
    body: 'TypeScript and Node.js APIs, sync, sign-in and admin tools: the parts users never see but every app depends on.',
  },
  {
    title: 'Data and reporting',
    body: 'Microsoft Fabric pipelines and Power BI dashboards that turn app and business data into reporting people actually open.',
  },
  {
    title: 'Music and sound',
    body: 'Music production, and the sound for the studio’s own products.',
  },
];

// `count` animates from zero; `pad` keeps the two-digit look while it counts.
const stats = [
  { count: 2, pad: 2, label: 'Platforms built natively: iOS and Android' },
  { count: 4, pad: 2, label: 'Disciplines under one roof' },
  { text: 'UK', label: 'Based in the United Kingdom' },
];

const title = 'Mazesys · Independent iOS and Android app studio, UK';
const description =
  'Mazesys is an independent UK studio that designs and builds iOS and Android apps, the APIs behind them, and Power BI and Microsoft Fabric reporting.';

const site = Astro.site!.href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}#organization`,
      name: 'Mazesys',
      url: site,
      logo: new URL('/apple-touch-icon.png', site).href,
      email: contactEmail,
      description,
      address: { '@type': 'PostalAddress', addressCountry: 'GB' },
      knowsAbout: skills,
      makesOffer: services.map((service) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: service.title, description: service.body },
      })),
    },
    {
      '@type': 'WebSite',
      '@id': `${site}#website`,
      url: site,
      name: 'Mazesys',
      inLanguage: 'en-GB',
      publisher: { '@id': `${site}#organization` },
    },
  ],
};
---

<Base {title} {description} {jsonLd} image="/og.png" imageAlt="The Mazesys maze logo: independent iOS and Android app studio, UK" bare>
  <section class="home">
    <div class="maze-logo" set:html={logo} />
    <p class="home-tagline">Independent app studio · UK</p>

    <ul class="skills" aria-label="Skills">
      {skills.map((skill, i) => <li style={`--i:${i}`}>{skill}</li>)}
    </ul>
  </section>

  <section class="home-section intro">
    <p class="eyebrow">Mobile app studio</p>
    <h1>iOS and Android apps, built end to end.</h1>
    <p class="lead">
      Mazesys designs and builds native apps for iPhone and Android, the backends behind them, and Power BI and
      Microsoft Fabric reporting. Design, code, APIs and data all come from one studio, so nothing gets lost in
      hand-offs between agencies.
    </p>
    <div class="intro-actions">
      <a class="contact-button" href={`mailto:${contactEmail}?subject=New%20project`}>Start a project</a>
      <a class="text-link" href="#products">See what we’ve built</a>
    </div>
  </section>

  <section class="home-section services" aria-labelledby="services-title">
    <p class="eyebrow">What we do</p>
    <h2 id="services-title">Everything an app needs, from one studio</h2>
    <ul class="service-list">
      {services.map((service) => (
        <li class="card">
          <h3>{service.title}</h3>
          <p>{service.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="home-section" aria-label="How the studio works">
    <StudioDiagram />

    <ul class="stats">
      {stats.map((stat) => (
        <li>
          <span class="stat-num" data-count={stat.count} data-pad={stat.pad}>
            {stat.text ?? String(stat.count).padStart(stat.pad ?? 1, '0')}
          </span>
          <span class="stat-label">{stat.label}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="home-section" id="products" aria-labelledby="products-title">
    <p class="eyebrow">Products</p>
    <h2 id="products-title">Our own apps</h2>
    <p class="section-lead">Alongside project work, Mazesys designs, builds and runs apps of its own.</p>
    <div class="apps">
      {apps.map((app) => (
        <a class="card app" href={`/${app.slug}/`}>
          <img src={app.icon} alt="" />
          <span>
            <strong>{app.name}</strong>
            <span class="app-tagline">{app.tagline}</span>
            <p>{app.summary}</p>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section contact" id="contact">
    <p class="eyebrow">Contact</p>
    <h2>Got a project, or a question about an app?</h2>
    <p>
      Email for app support, new work, or anything else. A real person reads every message and replies within a couple
      of working days.
    </p>
    <a class="contact-button" href={`mailto:${contactEmail}?subject=New%20project`}>{contactEmail}</a>
  </section>

  <Steroids />

  <footer class="home-footer">
    <span>© {new Date().getFullYear()} Mazesys</span>
    <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
  </footer>
</Base>

<script>
  // Diagram: light the paths that belong to the hovered or focused node.
  document.querySelectorAll<HTMLElement>('[data-diagram]').forEach((diagram) => {
    const clear = () => diagram.querySelectorAll('.lit').forEach((el) => el.classList.remove('lit'));
    diagram.querySelectorAll<SVGElement>('[data-node]').forEach((node) => {
      const light = () => {
        clear();
        const id = node.dataset.node!;
        node.classList.add('lit');
        node.closest('svg')!.querySelectorAll<SVGElement>('[data-keys]').forEach((path) => {
          if (id === 'hub' || path.dataset.keys!.split(' ').includes(id)) path.classList.add('lit');
        });
        diagram.classList.add('tracing');
      };
      const leave = () => { clear(); diagram.classList.remove('tracing'); };
      node.addEventListener('mouseenter', light);
      node.addEventListener('focus', light);
      node.addEventListener('mouseleave', leave);
      node.addEventListener('blur', leave);
    });
  });

  // Stats: count up once they scroll into view.
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const countUp = (el: HTMLElement) => {
    const target = Number(el.dataset.count);
    const pad = Number(el.dataset.pad ?? 1);
    const start = performance.now();
    const frame = (now: number) => {
      const p = Math.min((now - start) / 900, 1);
      el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3)))).padStart(pad, '0');
      if (p < 1) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  };
  if (!reduceMotion) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        countUp(entry.target as HTMLElement);
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.6 });
    counters.forEach((el) => observer.observe(el));
  }
</script>

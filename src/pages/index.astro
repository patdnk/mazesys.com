---
import Base from '../layouts/Base.astro';
import { apps, contactEmail } from '../data/apps';
---

<Base title="Mazesys" description="Mazesys makes small, thoughtful iPhone apps.">
  <p class="overline">Mazesys</p>
  <h1>Small, thoughtful<br />iPhone apps.</h1>
  <p class="lead">We make focused apps that do one job well and respect your privacy.</p>

  <h2>Apps</h2>
  <div class="apps">
    {apps.map((app) => (
      <a class="card app" href={`/${app.slug}/`}>
        <img src={app.icon} alt="" />
        <div>
          <strong>{app.name}</strong>
          <p>{app.summary}</p>
        </div>
      </a>
    ))}
  </div>

  <h2>Get in touch</h2>
  <p>Questions or feedback: <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
</Base>

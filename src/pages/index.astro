---
import Base from '../layouts/Base.astro';

const services = ['Mobile app development', 'Full-stack development', 'Music production'];
---

<Base title="Mazesys" description="Mazesys: mobile app development, full-stack development and music production." bare>
  <section class="home">
    <img class="home-logo" src="/mazesys-logo.png" alt="Mazesys" width="622" height="412" />

    <ul class="services">
      {services.map((service) => <li>{service}</li>)}
    </ul>
  </section>
</Base>

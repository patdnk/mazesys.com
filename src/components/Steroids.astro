---
// Steroids: Asteroids, but you shoot pills, and a syringe stands in for the UFO. Drawn in the home page's monochrome blueprint style.
// Desktop plays with the keyboard; touch screens get an on-canvas joystick and fire button.
// The best score stays in this browser only.
---

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />

<section class="home-section steroids" aria-label="Steroids, a small game">
  <p class="eyebrow">Break room</p>
  <canvas
    id="steroids"
    tabindex="0"
    aria-label="Steroids game. Press Enter to play. Arrow keys move, space shoots."
  ></canvas>
  <p class="steroids-hint">Arrows to move · Space to shoot</p>
</section>

<script>
  type Keys = { left: boolean; right: boolean; thrust: boolean; fire: boolean };
  type Ship = { x: number; y: number; a: number; vx: number; vy: number; inv: number };
  /** A capsule: `r` is half its length, `t` half its thickness. */
  type Pill = { x: number; y: number; r: number; t: number; size: number; vx: number; vy: number; a: number; spin: number };
  type Bullet = { x: number; y: number; vx: number; vy: number; life: number };
  type Bit = Bullet & { max: number };
  /** Steroids' answer to the UFO: crosses the screen, weaves up and down, and shoots drops at the ship. */
  type Syringe = { x: number; y: number; vx: number; vy: number; turn: number; reload: number };

  const TAU = Math.PI * 2;
  const PILL_R = [0, 12, 20, 34];
  const PILL_POINTS = [0, 100, 50, 20];
  const SYRINGE_POINTS = 500;
  const KEYMAP: Record<string, keyof Keys> = {
    ArrowLeft: 'left', KeyA: 'left', ArrowRight: 'right', KeyD: 'right', ArrowUp: 'thrust', KeyW: 'thrust', Space: 'fire',
  };
  const BEST_KEY = 'mazesys-steroids-best';

  // Arcade pixel font for in-game text only; the stylesheet link sits in this component, not the site head.
  const PIXEL_FONT = '"Press Start 2P", monospace';

  function init(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d')!;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const dark = matchMedia('(prefers-color-scheme: dark)');
    const coarse = matchMedia('(pointer: coarse)');

    let W = 0, H = 0, scale = 1;
    const colors = { ink: '', muted: '', tag: '', node: '' };
    const keys: Keys = { left: false, right: false, thrust: false, fire: false };
    // Touch: one finger on the left half drives the joystick (jx, jy in -1..1); any finger on the right half fires.
    const touch = { joyId: -1, jx: 0, jy: 0, fireIds: new Set<number>() };
    const game = {
      mode: 'idle' as 'idle' | 'playing' | 'paused' | 'over',
      score: 0, best: loadBest(), lives: 3, wave: 0, overAt: 0,
      ship: null as Ship | null, bullets: [] as Bullet[], pills: [] as Pill[], bits: [] as Bit[],
      syringe: null as Syringe | null, drops: [] as Bullet[], syringeIn: 0,
      cooldown: 0, respawn: 0, nextWave: 0,
    };

    function loadBest() {
      try { return Number(localStorage.getItem(BEST_KEY)) || 0; } catch { return 0; }
    }
    function saveBest() {
      try { localStorage.setItem(BEST_KEY, String(game.best)); } catch {}
    }

    // The monochrome palette lives on body.plain as --d-* tokens, inverted in dark mode. On a first visit
    // Safari can run this before the stylesheet applies, so use the same values as fallbacks and keep
    // re-reading on each draw until the tokens show up.
    let colorsLoaded = false;
    function readColors() {
      const s = getComputedStyle(document.body);
      const token = (name: string, light: string, darkValue: string) =>
        s.getPropertyValue(name).trim() || (dark.matches ? darkValue : light);
      colorsLoaded = s.getPropertyValue('--d-ink').trim() !== '';
      colors.ink = token('--d-ink', '#111111', '#EEEEEE');
      colors.muted = token('--d-muted', '#5C5C5C', '#A3A3A3');
      colors.tag = token('--d-tag', '#8A8A8A', '#7A7A7A');
      colors.node = token('--d-node', '#FFFFFF', '#0B0B0B');
    }

    function resize() {
      const w = canvas.clientWidth, h = canvas.clientHeight;
      if (!w || !h) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      W = w; H = h;
      scale = Math.max(0.6, Math.min(1, w / 700));
      // The idle screen's pills are sized to the canvas, which can start at the default 300 x 150 before the CSS lands.
      if (game.mode === 'idle') {
        game.pills = Array.from({ length: 5 }, () => makePill(Math.random() < 0.5 ? 2 : 3, rand(0, W), rand(0, H)));
      }
      if (!loop.running) draw();
    }

    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));
    const pad = (n: number) => String(n).padStart(6, '0');
    // Everything speeds up 18% a wave, up to 2.6x by wave 10.
    const pace = () => clamp(1 + (game.wave - 1) * 0.18, 1, 2.6);

    function wrap(o: { x: number; y: number }, m = 0) {
      if (o.x < -m) o.x += W + 2 * m; else if (o.x > W + m) o.x -= W + 2 * m;
      if (o.y < -m) o.y += H + 2 * m; else if (o.y > H + m) o.y -= H + 2 * m;
    }

    function makePill(size: number, x: number, y: number): Pill {
      const dir = rand(0, TAU);
      const speed = rand(20, 50) * (1 + (3 - size) * 0.45) * pace() * scale;
      const r = PILL_R[size] * scale;
      return {
        x, y, size, r, t: r * 0.45,
        vx: Math.cos(dir) * speed, vy: Math.sin(dir) * speed,
        a: rand(0, TAU), spin: rand(-1.2, 1.2),
      };
    }

    // Distance from (x, y) to a spine of half-length `half` centred on (cx, cy) at angle `a`.
    function spineDistance(cx: number, cy: number, a: number, half: number, x: number, y: number) {
      const c = Math.cos(a), s = Math.sin(a), dx = x - cx, dy = y - cy;
      const along = dx * c + dy * s;
      return Math.hypot(along - clamp(along, -half, half), dy * c - dx * s);
    }
    // Inside the pill when this is under `t`.
    const pillDistance = (p: Pill, x: number, y: number) => spineDistance(p.x, p.y, p.a, p.r - p.t, x, y);
    // The syringe is long and thin; it's hit within 6pt of its body, plunger to needle tip.
    const syringeDistance = (sy: Syringe, x: number, y: number) => spineDistance(sy.x, sy.y, 0, 25 * scale, x, y);
    const nextSyringe = () => rand(8, 14) / Math.sqrt(pace());

    function spawnSyringe() {
      const fromLeft = Math.random() < 0.5;
      game.syringe = {
        x: fromLeft ? -30 * scale : W + 30 * scale,
        y: rand(0.15, 0.85) * H,
        vx: (fromLeft ? 1 : -1) * rand(70, 90) * scale * Math.sqrt(pace()),
        vy: 0, turn: rand(0.6, 1.2), reload: 1,
      };
    }

    function spawnWave() {
      game.wave++;
      const cx = game.ship ? game.ship.x : W / 2, cy = game.ship ? game.ship.y : H / 2;
      const clear = Math.min(W, H) * 0.35;
      for (let i = 0; i < Math.min(2 + game.wave, 8); i++) {
        let x, y;
        do { x = rand(0, W); y = rand(0, H); } while (Math.hypot(x - cx, y - cy) < clear);
        game.pills.push(makePill(3, x, y));
      }
    }

    const newShip = (): Ship => ({ x: W / 2, y: H / 2, a: -Math.PI / 2, vx: 0, vy: 0, inv: 2.5 });

    function clearInput() {
      for (const k of Object.keys(keys) as (keyof Keys)[]) keys[k] = false;
      Object.assign(touch, { joyId: -1, jx: 0, jy: 0 });
      touch.fireIds.clear();
    }

    function start() {
      if (game.mode === 'over' && performance.now() - game.overAt < 800) return;
      Object.assign(game, {
        mode: 'playing', score: 0, lives: 3, wave: 0, bullets: [], pills: [], bits: [],
        syringe: null, drops: [], cooldown: 0, respawn: 0, nextWave: 0,
      });
      game.ship = newShip();
      spawnWave();
      game.syringeIn = nextSyringe();
      canvas.focus({ preventScroll: true });
      loop.start();
    }

    function resume() {
      game.mode = 'playing';
      canvas.focus({ preventScroll: true });
      loop.start();
    }

    function pause() {
      if (game.mode !== 'playing') return;
      game.mode = 'paused';
      clearInput();
      draw();
    }

    function play() {
      if (game.mode === 'paused') resume(); else if (game.mode !== 'playing') start();
    }

    function burst(x: number, y: number, n: number) {
      for (let i = 0; i < n; i++) {
        const a = rand(0, TAU), s = rand(30, 160) * scale, life = rand(0.4, 0.9);
        game.bits.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s, life, max: life });
      }
    }

    function breakPill(i: number) {
      const p = game.pills[i];
      game.pills.splice(i, 1);
      game.score += PILL_POINTS[p.size];
      burst(p.x, p.y, 6 + p.size * 4);
      if (p.size > 1) for (let k = 0; k < 2; k++) game.pills.push(makePill(p.size - 1, p.x, p.y));
    }

    function killShip() {
      const ship = game.ship!;
      burst(ship.x, ship.y, 24);
      game.ship = null;
      game.lives--;
      if (game.lives > 0) {
        game.respawn = 1.6;
      } else {
        game.mode = 'over';
        game.overAt = performance.now();
        clearInput();
        if (game.score > game.best) { game.best = game.score; saveBest(); }
      }
    }

    function killSyringe() {
      const sy = game.syringe!;
      burst(sy.x, sy.y, 18);
      game.syringe = null;
      game.syringeIn = nextSyringe();
    }

    function updateSyringe(dt: number) {
      if (!game.syringe) {
        if (game.mode === 'playing' && (game.syringeIn -= dt) <= 0) spawnSyringe();
        return;
      }
      const sy = game.syringe;
      sy.x += sy.vx * dt;
      sy.y += sy.vy * dt;
      if (sy.y < 0) sy.y += H; else if (sy.y > H) sy.y -= H;
      if ((sy.turn -= dt) <= 0) {
        sy.turn = rand(0.8, 1.6);
        sy.vy = [-1, 0, 1][Math.floor(Math.random() * 3)] * 45 * scale;
      }
      if (sy.x < -40 * scale || sy.x > W + 40 * scale) {
        game.syringe = null;
        game.syringeIn = nextSyringe();
        return;
      }
      // Fires from the needle, aimed at the ship; aim and rate of fire tighten each wave.
      const ship = game.ship;
      if (game.mode === 'playing' && ship && (sy.reload -= dt) <= 0) {
        sy.reload = 1.6 / pace();
        const tipX = sy.x + Math.sign(sy.vx) * 26 * scale;
        const aim = Math.atan2(ship.y - sy.y, ship.x - tipX) + rand(-1, 1) * Math.max(0.08, 0.5 - game.wave * 0.05);
        const speed = 200 * scale;
        game.drops.push({ x: tipX, y: sy.y, vx: Math.cos(aim) * speed, vy: Math.sin(aim) * speed, life: 1.6 });
      }
    }

    function update(dt: number) {
      const ship = game.ship;
      if (game.mode === 'playing' && ship) {
        let thrust = keys.thrust ? 1 : 0;
        ship.a += ((keys.right ? 1 : 0) - (keys.left ? 1 : 0)) * 4.2 * dt;
        // The joystick points the ship where the thumb points and thrusts harder the further it's pushed.
        const push = Math.hypot(touch.jx, touch.jy);
        if (touch.joyId >= 0 && push > 0.2) {
          const turn = Math.atan2(touch.jy, touch.jx) - ship.a;
          ship.a += clamp(Math.atan2(Math.sin(turn), Math.cos(turn)), -9 * dt, 9 * dt);
          if (push > 0.35) thrust = Math.max(thrust, push);
        }
        ship.vx += Math.cos(ship.a) * 260 * scale * thrust * dt;
        ship.vy += Math.sin(ship.a) * 260 * scale * thrust * dt;
        const drag = Math.pow(0.45, dt);
        ship.vx *= drag; ship.vy *= drag;
        ship.x += ship.vx * dt; ship.y += ship.vy * dt;
        wrap(ship, 12 * scale);
        ship.inv = Math.max(0, ship.inv - dt);

        game.cooldown -= dt;
        if ((keys.fire || touch.fireIds.size) && game.cooldown <= 0 && game.bullets.length < 6) {
          const cos = Math.cos(ship.a), sin = Math.sin(ship.a), speed = 480 * scale;
          game.bullets.push({
            x: ship.x + cos * 14 * scale, y: ship.y + sin * 14 * scale,
            vx: cos * speed + ship.vx, vy: sin * speed + ship.vy, life: 0.9,
          });
          game.cooldown = 0.2;
        }
      }

      for (const b of game.bullets) { b.x += b.vx * dt; b.y += b.vy * dt; b.life -= dt; wrap(b); }
      game.bullets = game.bullets.filter((b) => b.life > 0);
      for (const p of game.pills) { p.x += p.vx * dt; p.y += p.vy * dt; p.a += p.spin * dt; wrap(p, p.r); }
      const bitDrag = Math.pow(0.3, dt);
      for (const p of game.bits) { p.x += p.vx * dt; p.y += p.vy * dt; p.vx *= bitDrag; p.vy *= bitDrag; p.life -= dt; }
      game.bits = game.bits.filter((p) => p.life > 0);
      updateSyringe(dt);
      for (const d of game.drops) { d.x += d.vx * dt; d.y += d.vy * dt; d.life -= dt; wrap(d); }
      game.drops = game.drops.filter((d) => d.life > 0);

      if (game.mode !== 'playing') return;

      for (let i = game.pills.length - 1; i >= 0; i--) {
        const p = game.pills[i];
        const hit = game.bullets.findIndex((b) => pillDistance(p, b.x, b.y) < p.t + 1.5);
        if (hit >= 0) { game.bullets.splice(hit, 1); breakPill(i); }
      }

      const sy = game.syringe;
      if (sy) {
        const hit = game.bullets.findIndex((b) => syringeDistance(sy, b.x, b.y) < 6 * scale + 1.5);
        if (hit >= 0) { game.bullets.splice(hit, 1); game.score += SYRINGE_POINTS; killSyringe(); }
      }

      if (ship && ship.inv <= 0) {
        const hitPill = game.pills.some((p) => pillDistance(p, ship.x, ship.y) < p.t + 7 * scale);
        const hitSyringe = game.syringe && syringeDistance(game.syringe, ship.x, ship.y) < 13 * scale;
        const drop = game.drops.findIndex((d) => Math.hypot(d.x - ship.x, d.y - ship.y) < 8 * scale);
        if (hitSyringe) killSyringe();
        if (drop >= 0) game.drops.splice(drop, 1);
        if (hitPill || hitSyringe || drop >= 0) killShip();
      }
      if (!game.ship && game.lives > 0) {
        game.respawn -= dt;
        if (game.respawn <= 0) game.ship = newShip();
      }
      if (!game.pills.length) {
        game.nextWave += dt;
        if (game.nextWave > 1.2) { game.nextWave = 0; spawnWave(); }
      }
    }

    // Two-tone capsule: one half solid, one half outlined, split down the middle.
    function drawPill(p: Pill) {
      const half = p.r - p.t;
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.a);
      ctx.beginPath();
      ctx.arc(-half, 0, p.t, Math.PI / 2, Math.PI * 1.5);
      ctx.arc(half, 0, p.t, -Math.PI / 2, Math.PI / 2);
      ctx.closePath();
      ctx.fillStyle = colors.node;
      ctx.fill();
      ctx.save();
      ctx.clip();
      ctx.fillStyle = colors.ink;
      ctx.fillRect(-p.r, -p.t, p.r, p.t * 2);
      ctx.restore();
      ctx.lineWidth = 1.5;
      ctx.strokeStyle = colors.ink;
      ctx.stroke();
      ctx.restore();
    }

    // Barrel half full, flange and plunger behind, needle in front, facing the way it travels.
    function drawSyringe(sy: Syringe) {
      ctx.save();
      ctx.translate(sy.x, sy.y);
      ctx.scale(Math.sign(sy.vx) * scale, scale);
      ctx.strokeStyle = colors.ink;
      ctx.fillStyle = colors.node;
      ctx.lineWidth = 1.5 / scale;
      ctx.fillRect(-14, -5, 24, 10);
      ctx.fillStyle = colors.ink;
      ctx.fillRect(-2, -5, 12, 10);
      ctx.strokeRect(-14, -5, 24, 10);
      ctx.fillRect(10, -2.5, 3, 5);
      ctx.beginPath();
      ctx.moveTo(-14, -9); ctx.lineTo(-14, 9);
      ctx.moveTo(-14, 0); ctx.lineTo(-24, 0);
      ctx.moveTo(-24, -6); ctx.lineTo(-24, 6);
      ctx.stroke();
      ctx.lineWidth = 1 / scale;
      ctx.beginPath();
      ctx.moveTo(13, 0); ctx.lineTo(26, 0);
      ctx.stroke();
      ctx.restore();
    }

    function drawShip(x: number, y: number, a: number, s: number, flame: boolean) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(a);
      if (flame) {
        ctx.beginPath();
        ctx.moveTo(-8 * s, -4 * s);
        ctx.lineTo(-(14 + Math.random() * 6) * s, 0);
        ctx.lineTo(-8 * s, 4 * s);
        ctx.strokeStyle = colors.muted;
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }
      ctx.beginPath();
      ctx.moveTo(14 * s, 0);
      ctx.lineTo(-10 * s, -9 * s);
      ctx.lineTo(-6 * s, 0);
      ctx.lineTo(-10 * s, 9 * s);
      ctx.closePath();
      ctx.fillStyle = colors.ink;
      ctx.fill();
      ctx.restore();
    }

    const joystick = () => ({ x: 22 + 44, y: H - 22 - 44, R: 44 });
    const fireButton = () => ({ x: W - 22 - 34, y: H - 22 - 34, R: 34 });

    /** Draws uppercase pixel text centred vertically on `y`, shrinking the size until it fits the canvas width. */
    function pixelText(text: string, x: number, y: number, size: number, align: CanvasTextAlign, color: string) {
      const fit = Math.floor((W - 24) / text.length);
      ctx.font = `${Math.max(6, Math.min(size, fit))}px ${PIXEL_FONT}`;
      ctx.textAlign = align;
      ctx.textBaseline = 'middle';
      ctx.fillStyle = color;
      ctx.fillText(text.toUpperCase(), x, y);
    }

    function drawTouchControls() {
      const j = joystick(), f = fireButton(), active = touch.joyId >= 0, firing = touch.fireIds.size > 0;
      ctx.lineWidth = 1.5;
      ctx.strokeStyle = colors.tag;
      ctx.globalAlpha = active ? 0.9 : 0.55;
      ctx.beginPath();
      ctx.arc(j.x, j.y, j.R, 0, TAU);
      ctx.stroke();
      ctx.fillStyle = colors.ink;
      ctx.beginPath();
      ctx.arc(j.x + touch.jx * j.R * 0.6, j.y + touch.jy * j.R * 0.6, 17, 0, TAU);
      ctx.fill();

      ctx.globalAlpha = firing ? 0.9 : 0.55;
      ctx.beginPath();
      ctx.arc(f.x, f.y, f.R, 0, TAU);
      if (firing) ctx.fill(); else ctx.stroke();
      ctx.globalAlpha = 1;
      pixelText('FIRE', f.x, f.y + 1, 9, 'center', firing ? colors.node : colors.tag);
    }

    function drawHud() {
      const size = W < 420 ? 8 : 10;
      if (game.mode !== 'idle') {
        pixelText(`SCORE ${pad(game.score)}`, 12, 19, size, 'left', colors.tag);
        pixelText(`WAVE ${String(game.wave).padStart(2, '0')}`, W / 2, 19, size, 'center', colors.tag);
        for (let i = 0; i < game.lives; i++) drawShip(18 + i * 16, 42, -Math.PI / 2, 0.55, false);
      }
      if (game.best) pixelText(`BEST ${pad(game.best)}`, W - 12, 19, size, 'right', colors.tag);
    }

    function drawOverlay(title: string, ...lines: string[]) {
      ctx.globalAlpha = 0.75;
      ctx.fillStyle = colors.node;
      ctx.fillRect(0, 0, W, H);
      ctx.globalAlpha = 1;
      const top = H / 2 - lines.length * 10;
      pixelText(title, W / 2, top, Math.round(16 + 12 * scale), 'center', colors.ink);
      lines.forEach((line, i) => pixelText(line, W / 2, top + 36 + i * 20, 10, 'center', colors.muted));
    }

    function draw() {
      if (!W) return;
      if (!colorsLoaded) readColors();
      canvas.classList.toggle('playing', game.mode === 'playing');
      ctx.clearRect(0, 0, W, H);
      ctx.lineJoin = 'round';
      for (const p of game.pills) drawPill(p);
      ctx.fillStyle = colors.ink;
      for (const b of game.bullets) {
        ctx.beginPath();
        ctx.arc(b.x, b.y, Math.max(1.6, 2.2 * scale), 0, TAU);
        ctx.fill();
      }
      if (game.syringe) drawSyringe(game.syringe);
      ctx.strokeStyle = colors.ink;
      ctx.lineWidth = 1.5;
      for (const d of game.drops) {
        ctx.beginPath();
        ctx.arc(d.x, d.y, Math.max(2, 2.6 * scale), 0, TAU);
        ctx.stroke();
      }
      ctx.fillStyle = colors.muted;
      for (const p of game.bits) {
        ctx.globalAlpha = Math.max(0, p.life / p.max);
        ctx.fillRect(p.x - 1.5, p.y - 1.5, 3, 3);
      }
      ctx.globalAlpha = 1;
      const ship = game.ship;
      if (ship && (ship.inv <= 0 || Math.floor(ship.inv * 8) % 2 === 0)) {
        const thrusting = keys.thrust || (touch.joyId >= 0 && Math.hypot(touch.jx, touch.jy) > 0.35);
        drawShip(ship.x, ship.y, ship.a, scale, thrusting && game.mode === 'playing');
      }
      if (coarse.matches && game.mode === 'playing') drawTouchControls();

      const tap = coarse.matches ? 'Tap' : 'Click or press Enter';
      if (game.mode === 'idle') drawOverlay('Steroids', `${tap} to play`);
      else if (game.mode === 'paused') drawOverlay('Paused', `${tap} to resume`);
      else if (game.mode === 'over') {
        const best = game.score > 0 && game.score >= game.best;
        drawOverlay(best ? 'New best' : 'Game over', `${game.score.toLocaleString('en-GB')} points`, `${tap} to play again`);
      }
      drawHud();
    }

    const loop = {
      running: false,
      visible: true,
      last: 0,
      shouldRun() {
        return this.visible && !document.hidden && game.mode !== 'paused' && (game.mode === 'playing' || !reduceMotion.matches);
      },
      start() {
        if (this.running || !this.shouldRun()) { draw(); return; }
        this.running = true;
        this.last = performance.now();
        requestAnimationFrame(tick);
      },
    };

    function tick(now: number) {
      if (!loop.shouldRun()) { loop.running = false; draw(); return; }
      const dt = Math.min((now - loop.last) / 1000, 1 / 20);
      loop.last = now;
      update(dt);
      draw();
      requestAnimationFrame(tick);
    }

    canvas.addEventListener('keydown', (e) => {
      if (game.mode !== 'playing') {
        if (e.code === 'Enter' || e.code === 'Space') { e.preventDefault(); play(); }
        return;
      }
      if (e.code === 'Escape' || e.code === 'KeyP') { pause(); return; }
      const k = KEYMAP[e.code];
      if (k) { e.preventDefault(); keys[k] = true; }
    });
    canvas.addEventListener('keyup', (e) => {
      const k = KEYMAP[e.code];
      if (k) keys[k] = false;
    });
    canvas.addEventListener('click', play);
    canvas.addEventListener('blur', () => { if (!coarse.matches) pause(); });

    const moveJoystick = (e: PointerEvent) => {
      const rect = canvas.getBoundingClientRect(), j = joystick();
      const dx = e.clientX - rect.left - j.x, dy = e.clientY - rect.top - j.y;
      const k = Math.min(1, j.R / (Math.hypot(dx, dy) || 1)) / j.R;
      touch.jx = dx * k;
      touch.jy = dy * k;
    };
    canvas.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'touch' || game.mode !== 'playing') return;
      e.preventDefault();
      try { canvas.setPointerCapture(e.pointerId); } catch {}
      const x = e.clientX - canvas.getBoundingClientRect().left;
      if (x < W / 2 && touch.joyId < 0) { touch.joyId = e.pointerId; moveJoystick(e); }
      else touch.fireIds.add(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e) => {
      if (e.pointerId === touch.joyId) moveJoystick(e);
    });
    const lift = (e: PointerEvent) => {
      if (e.pointerId === touch.joyId) Object.assign(touch, { joyId: -1, jx: 0, jy: 0 });
      touch.fireIds.delete(e.pointerId);
    };
    canvas.addEventListener('pointerup', lift);
    canvas.addEventListener('pointercancel', lift);
    canvas.addEventListener('contextmenu', (e) => e.preventDefault());

    new IntersectionObserver(([entry]) => {
      loop.visible = entry.isIntersecting;
      if (loop.visible) loop.start(); else pause();
    }).observe(canvas);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pause(); else loop.start();
    });
    reduceMotion.addEventListener('change', () => loop.start());
    dark.addEventListener('change', () => { readColors(); draw(); });
    coarse.addEventListener('change', draw);

    readColors();
    new ResizeObserver(resize).observe(canvas);
    resize();
    loop.start();
    document.fonts?.load(`16px ${PIXEL_FONT}`).then(draw, () => {});
    window.addEventListener('load', draw);
  }

  const canvas = document.getElementById('steroids');
  if (canvas instanceof HTMLCanvasElement) init(canvas);
</script>
